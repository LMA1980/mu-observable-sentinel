# ==============================================================================
# MuObservable Host Sentinel Configuration Environment
# Path: /etc/mu-observable-sentinel/sentinel.env
# Permissions: 0600 mu-observable-sentinel:mu-observable-sentinel
# ==============================================================================

# Enable continuous polling and /dev/kmsg streaming loop (required under systemd)
MU_OBSERVABLE_SENTINEL_SERVE=true

# Logical node identifier attached to emitted metrics and logs
MU_OBSERVABLE_SENTINEL_NODE_ID=worker-node

# Local mu-observable-collector OTLP/HTTP base URL
MU_OBSERVABLE_SENTINEL_COLLECTOR_URL=http://127.0.0.1:4318

# Polling interval between procfs/sysfs sweeps (seconds)
MU_OBSERVABLE_SENTINEL_POLL_SECS=5

# Block I/O read/write await latency warning threshold (milliseconds)
MU_OBSERVABLE_SENTINEL_DISK_AWAIT_WARN_MS=500

# Pressure Stall Information (PSI) avg10 warning threshold (%)
MU_OBSERVABLE_SENTINEL_PSI_WARN_PCT=10

# Consecutive sweeps required before PSI or user-space D-state alerts emit
MU_OBSERVABLE_SENTINEL_PSI_PERSISTENCE_SAMPLES=3

# Cooldown window between repeated psi_dstate or runaway_process alerts (seconds)
MU_OBSERVABLE_SENTINEL_ALERT_COOLDOWN_SECS=300

# Maximum elapsed runtime for active monitored build/test processes (seconds)
MU_OBSERVABLE_SENTINEL_RUNAWAY_SECS=2100

# Seek /dev/kmsg to tail on startup to avoid replaying historical boot records
MU_OBSERVABLE_SENTINEL_KMSG_SEEK_TAIL=true

# Persistent /dev/kmsg sequence checkpoint path scoped by host boot_id
MU_OBSERVABLE_SENTINEL_KMSG_CHECKPOINT_PATH=/var/lib/mu-observable-sentinel/kmsg.ckpt

# Configuration directory allowlisted for read-only Landlock access
MU_OBSERVABLE_SENTINEL_CONFIG_DIR=/etc/mu-observable-sentinel

# Enforce MuIsolation Landlock V3+ filesystem sandbox at startup on Linux
MU_OBSERVABLE_SENTINEL_ENFORCE_LANDLOCK=false

# Tracing and logging level
RUST_LOG=info,mu_observable_sentinel=debug
